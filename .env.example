# SQLite file used by Prisma. Path is relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"

# Public URL of this app (used for auth cookies and redirects).
NEXTAUTH_URL="http://localhost:3000"

# Secret used to sign JWT sessions. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
